# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (git-ignored) and fill in your real values.
#   cp .env.example .env
# Never commit .env — credentials live here or in your hosting dashboard only.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (Neon) ────────────────────────────────────────────────────────
# Runtime connection string. On Neon, use the POOLED url (host contains
# "-pooler") and add &pgbouncer=true for compatibility with Prisma:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Migrations need a DIRECT (unpooled) connection — same URL as Neon gives you,
# but WITHOUT "-pooler" in the host. On Vercel, add this as a separate env var.
# For local development you can point BOTH variables at the same direct URL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-32-char-secret"

# ── Seed (only used by `npm run db:seed` — never during build) ───────────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
